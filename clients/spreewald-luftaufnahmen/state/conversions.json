  "levels": {
    "lead": {
      "label": "Lead / Contact",
      "description": "Anfrage oder direkte Kontaktaktion. Höchste Funnel-Stufe für die SEO-Business-Priorisierung.",
      "subtypes": {
        "form_submission": "Form Submission (Formular / Heyflow abgesendet)",
        "contact_action": "Direct Contact Action (Telefon / E-Mail / Chat) – Kontakt technisch nicht bestätigt"
      }
    },
    "micro": {
      "label": "Micro Conversion / Funnel Intent",
      "description": "Aktive Interaktion mit dem Anfrageprozess (Heyflow). Starke Kontaktabsicht, aber kein Lead – wird nie mit Leads addiert."
    },
    "engagement": {
      "label": "Engagement",
      "description": "Normales Nutzungssignal (Scrollen, Video). Keine Conversion."
    },
    "outbound": {
      "label": "Outbound / sonstige",
      "description": "Klicks zu externen Plattformen (Facebook, YouTube, ausgehende Links). Separat sichtbar, nicht für die Business-Priorisierung."
    },
    "system": {
      "label": "System (automatisch)",
      "description": "Automatisch erfasste GA4-Events."
    },
    "unused": {
      "label": "Nicht genutzt",
      "description": "Konfiguriert, aber nie ausgelöst."
    }
  },
